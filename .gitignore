# ============================================================

# .gitignore

# Node.js + React Native + Kotlin/Android + Dart + Flutter

# Aplicable a proyectos y subproyectos en cualquier nivel

# ============================================================

# ============================================================

# SISTEMAS OPERATIVOS

# ============================================================

# Windows

Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS

.DS_Store
.AppleDouble
.LSOverride
._*

# Linux

*~
.directory
.Trash-*
.nfs*

# ============================================================

# EDITORES / IDEs

# ============================================================

# Visual Studio Code

.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# JetBrains / IntelliJ / Android Studio

.idea/
*.iml
*.iws
*.ipr

# Eclipse

.classpath
.project
.settings/

# NetBeans

/nbproject/private/
/nbbuild/
/dist/
/nbdist/
.nb-gradle/

# Sublime Text

*.sublime-workspace
*.sublime-project

# Vim

*.swp
*.swo
*.swn

# Emacs

*~
#*#

# ============================================================

# VARIABLES DE ENTORNO / SECRETOS

# ============================================================

.env
.env.*
!.env.example
!.env.sample
!.env.template

# Certificados / claves privadas

*.pem
*.key
*.p12
*.pfx
*.keystore
*.jks

# IMPORTANTE:

# Si necesitas guardar un keystore de Android en Git,

# elimina *.keystore y *.jks de esta sección.

